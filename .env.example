# InnoCalc Manager settings.
# The desktop launcher needs none of these. They are read from the environment;
# on the application host the tenant's compose env_file supplies them (Step 3
# derives deploy/prod.env.example and deploy/preview.env.example from this file).
# Never commit a filled-in copy: .env and deploy/*.env are ignored by Git.

# --- Where it listens --------------------------------------------------------
# 127.0.0.1 keeps the desktop helpers (folder picker, Explorer, opening the
# browser). Any other address is server mode: those helpers are withdrawn and
# every path a browser supplies must lie under ICM_ROOT.
ICM_HOST=127.0.0.1
ICM_PORT=8125

# --- Storage -----------------------------------------------------------------
# Projects share. On the server this is the mount point of the projects drive.
ICM_ROOT=J:\Active Projects
# Roots that older PC records were written under; recognised and re-based onto ICM_ROOT.
ICM_LEGACY_ROOTS=J:\Active Projects
# How people reach ICM_ROOT from Windows (J:\Active Projects or \\fileserver\Projects);
# used for links in draft emails. Blank uses ICM_ROOT as written.
ICM_SHARE_PATH=
# Registry, people directory and discovery index. Local disk only (ext4 on the
# server), never the file share, and never mounted into two instances at once.
ICM_DATA_DIR=
# Snapshots of ICM_DATA_DIR. Default: a "backups" folder beside ICM_DATA_DIR.
ICM_BACKUP_DIR=
# Minutes between snapshots (the first is taken 30 s after start); 0 disables.
ICM_BACKUP_INTERVAL_MINUTES=60
ICM_BACKUP_RETENTION_DAYS=14

# --- Sign-in -----------------------------------------------------------------
# dev   : a person types their Innovis email; no passwords. Trusted networks only.
# proxy : the reverse proxy signs the person in (Entra ID at the edge) and passes
#         their address on ICM_SSO_USER_HEADER. The header is refused (401,
#         logged) from any peer not in ICM_TRUSTED_PROXIES.
ICM_AUTH_MODE=dev
ICM_SSO_USER_HEADER=X-Ms-Client-Principal-Name
# Comma-separated addresses with the admin role, in addition to people.json.
ICM_ADMINS=
# The in-app Office 365 flow. Leave at 0; it must stay 0 in proxy mode.
ICM_SSO_ENABLED=0

# --- Network trust -----------------------------------------------------------
# Only these peers may set X-Forwarded-Proto/Host or the identity header.
# Comma-separated IPs or CIDRs. On the application host: 172.30.0.2 (Caddy).
ICM_TRUSTED_PROXIES=127.0.0.1
# Accepted Host headers; any other gets 400. Blank accepts any (local use).
# A container health probe must send one of these as its Host header.
ICM_ALLOWED_HOSTS=
# true when served over HTTPS by the proxy: adds Strict-Transport-Security.
ICM_HTTPS=false

# --- Preview instances and unfinished work -----------------------------------
# true on preview: every route that writes to the projects share returns 409.
# Mount the projects share read-only for preview as well.
ICM_READ_ONLY=false
# Production server only: mark ICM_ROOT as server-managed (.innocalc-server.json).
# Every PC copy whose projects root holds the marker then refuses to write, so PCs
# and the server never update the same projects. Set it on cut-over day.
ICM_OWNS_PROJECTS=false
# Withhold tabs from all but admins: tab=role pairs.
# Tabs: library, calculation, package, qa. Roles: user, admin.
# Blank means package=admin,qa=admin until PDF export passes its gate (ROADMAP.md).
# Open them to everyone with: ICM_TAB_ACCESS=package=user,qa=user
ICM_TAB_ACCESS=
# Withhold enabled calculation modules the same way, by suite.toml id.
# Example: ICM_MODULE_ACCESS=concrete-corbel=admin
ICM_MODULE_ACCESS=

# --- PDF printing ------------------------------------------------------------
# Chromium executable when it is not in a standard location.
INNOCALC_BROWSER=
# Extra Chromium flags, e.g. --no-sandbox inside a locked-down container.
INNOCALC_BROWSER_ARGS=
